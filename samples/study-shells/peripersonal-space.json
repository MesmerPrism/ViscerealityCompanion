{
  "id": "peripersonal-space",
  "label": "Peripersonal Space",
  "partner": "Peripersonal study team",
  "description": "Dedicated WPF operator shell for the peripersonal-space Unity runtime and Quest questionnaire panel. Windows owns session metadata, command ledger, readiness gates, mirrored LSL data, and review artifacts.",
  "app": {
    "label": "Peripersonal Unity Runtime APK",
    "packageId": "com.Viscereality.ViscerealityPeriPersonal",
    "apkPath": "../quest-session-kit/APKs/PeripersonalRuntime.apk",
    "launchComponent": "com.Viscereality.ViscerealityPeriPersonal/com.unity3d.player.UnityPlayerGameActivity",
    "sha256": "1b1641ed8f5de677fe78c44c04210a04b3f247f37381ba4247b156e2e29112e9",
    "versionName": "2026.06.20-single-runtime",
    "notes": "Fresh single runtime APK built from S:/Work/repos/active/peripersonal-space-experiment-2025-12-10 on 2026-06-20. Unity package com.Viscereality.ViscerealityPeriPersonal; default particles invisible; runtime condition selection enabled.",
    "allowManualSelection": true,
    "launchInKioskMode": false
  },
  "deviceProfile": {
    "id": "peripersonal-study-profile",
    "label": "Peripersonal Study Device Profile",
    "description": "Initial Quest device settings and private companion constants for the peripersonal workflow.",
    "properties": {
      "debug.oculus.cpuLevel": "5",
      "debug.oculus.gpuLevel": "5",
      "debug.oculus.foveation.dynamic": "false",
      "debug.oculus.foveation.level": "1",
      "viscereality.panel.package": "io.github.mesmerprism.questquestionnaire.panel",
      "viscereality.panel.launchComponent": "io.github.mesmerprism.questquestionnaire.panel/.QuestionnaireActivity",
      "viscereality.panel.prepareBroadcastAction": "io.github.mesmerprism.questquestionnaire.panel.action.PERIPERSONAL_COMMAND",
      "viscereality.panel.prepareCommandJsonExtra": "io.github.mesmerprism.questquestionnaire.panel.extra.COMMAND_JSON",
      "viscereality.panel.prepareReceiptJsonExtra": "io.github.mesmerprism.questquestionnaire.panel.extra.RECEIPT_JSON",
      "viscereality.panel.targetRuntimeKind": "quest_questionnaire_panel_apk",
      "viscereality.minimum_headset_battery_percent": "50",
      "viscereality.recordingLifecycle": "one_global_recording_after_block_1",
      "viscereality.sessionFolderNaming": "participantRef_sessionId_yyyyMMdd-HHmmss",
      "viscereality.breathTrackingControllerRule": "right-handed=>left-controller; left-handed=>right-controller",
      "viscereality.runtimeStateLslStreamPattern": "peripersonal_runtime_state_{participantRef}",
      "viscereality.particleTriggerLslStreamPattern": "peripersonal_particle_triggers_{participantRef}"
    }
  },
  "monitoring": {
    "expectedBreathingLabel": "",
    "expectedHeartbeatLabel": "",
    "expectedCoherenceLabel": "",
    "expectedLslStreamName": "peripersonal_runtime_state_{participantRef}",
    "expectedLslStreamType": "peripersonal.runtime.state",
    "recenterDistanceThresholdUnits": 0.2,
    "lslConnectivityKeys": [
      "study.recording.device.active",
      "study.session.id",
      "runtime.app.identifier"
    ],
    "lslStreamNameKeys": [
      "peripersonal_runtime_state",
      "peripersonal_particle_triggers",
      "quest_twin_state"
    ],
    "lslStreamTypeKeys": [
      "peripersonal.runtime.state",
      "peripersonal.particle.trigger",
      "quest.twin.state"
    ],
    "lslValueKeys": [
      "study.recording.device.active",
      "study.recording.device.session_folder_name",
      "study.session.dataset_id",
      "study.session.breath_tracking_controller_side"
    ],
    "controllerValueKeys": [
      "controller.position.x",
