      "performance.fps"
    ],
    "performanceFrameTimeKeys": [
      "performance.frame_ms"
    ],
    "performanceTargetFpsKeys": [
      "performance.target_fps"
    ],
    "performanceRefreshRateKeys": [
      "performance.refresh_hz"
    ],
    "recenterDistanceKeys": [],
